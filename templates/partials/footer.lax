<footer class="container bg-light rounded-5 mb-2 desktop">
        <div class="row mt-5 p-3 p-md-5">
            
            <div class="col-md-6">
             <img class="img-fluid col-md-4 rounded-circle"
            alt="@metadata.title" width="100%" height="100%"
            src="@metadata.image"/>
                <h3>@metadata.footer.nav1.title</h3>
                <p>@metadata.footer.nav1.description</p>
            </div>
            
            <div class="col-md-2 p-3">
                <ul>
                    @for metadata.footer.nav2
                        <li><a href="@url">@title</a></li>
                    @end
                </ul>
            </div>
            
            <div class="col-md-2 p-3">
                <ul>
                    @for metadata.footer.nav3
                        <li><a href="@url">@title</a></li>
                    @end
                </ul>
            </div>
            
            <div class="col-md-2 p-3">
                <ul>
                    @for metadata.footer.nav4
                        <li><a href="@url">@title</a></li>
                    @end
                </ul>
            </div>
        </div>
         <div class="col-md-12 text-center p-1 mt-2 mb-1">
 <p class="small">&copy; @os.date - @metadata.title | Built with <a href="https://luax.axcora.com">LUAX</a></p>
 </div>
</footer>
<footer class="container bg-light rounded-top-5 mobile">
        <div class="row mt-5 p-3 p-md-5">
            
            <div class="col-12 p-3 text-center">
             <img class="img-fluid col-6 rounded-circle"
            alt="@metadata.title" width="100%" height="100%"
            src="@metadata.image"/>
                <h3>@metadata.footer.nav1.title</h3>
                <p>@metadata.footer.nav1.description</p>
            </div>
            
            <div class="col-6 p-3">
                <ul>
                    @for metadata.footer.nav2
                        <li><a href="@url">@title</a></li>
                    @end
                </ul>
            </div>
            
            <div class="col-6 p-3">
                <ul>
                    @for metadata.footer.nav3
                        <li><a href="@url">@title</a></li>
                    @end
                </ul>
            </div>
            
            <div class="col-12 p-3">
                <ul>
                    @for metadata.footer.nav4
                        <li><a href="@url">@title</a></li>
                    @end
                </ul>
            </div>
        </div>
         <div class="col-md-12 text-center p-1 mt-2 mb-1">
 <p class="small">&copy; @os.date - @metadata.title | Built with <a href="https://luax.axcora.com">LUAX</a></p>
 </div>
</footer>