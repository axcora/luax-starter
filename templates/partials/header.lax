<header class="container bg-light rounded-5 desktop mt-3">
    <nav class="row">
        <a href="/" class="col-md-4 col-12 p-3 navbar-brand">
            @if metadata.navbar.logo
                <img src="@metadata.navbar.logo" alt="@metadata.title"
                width="40" height="40" class="img-fluid"/>
            @else
                @metadata.title
            @end
        </a>
        
        <ul class="col-md-8 col-12 text-center p-3 nav justify-content-end">
            @for metadata.navbar.list
                <li class="nav-item">
                    <a href="@url" class="nav-link">@title</a>
                </li>
            @end
        </ul>
    </nav>
</header>
<header class="container mobile bg-light p-3 rounded-bottom-5 shaodw-sm">
    <nav class="row   justify-content-center text-center">
        <a href="/" class="col-md-12 p-2 navbar-brand">
            @if metadata.navbar.logo
                <img src="@metadata.navbar.logo" alt="@metadata.title"
                width="40" height="40" class="img-fluid"/><br/>
            @else
                @metadata.title
            @end
        </a>
        
        <ul class="col-md-12 text-center p-2 nav justify-content-center">
            @for metadata.navbar.list
                <li class="nav-item">
                    <a href="@url" class="nav-link">@title</a>
                </li>
            @end
        </ul>
    </nav>
</header>