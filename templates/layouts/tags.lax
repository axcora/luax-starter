@layout(default)

<main class="container">
    <section class="row">
        <div class="col-md-12 p-3 p-md-5 text-center mt-3">
            <h1 class="display-4">🏷️ @metadata.tags.title</h1>
            <h2 class="lead">@metadata.tags.description</h2>
        </div>

        @if metadata.tags.image
        <div class="ratio ratio-21x9 mt-1 mb-3 p-3">
        <img class="img-cover rounded-5 shadow-sm"
        alt="@metadata.tags.title"
        width="100%"
        height="100%"
        SRC="@metadata.tags.image"/>
        </div>
        @end
        
        <div class="col-md-8 mx-auto p-3">
            <div class="d-flex flex-wrap gap-2 justify-content-center">
                @for tags
                    <a href="/tags/@clean.html" class="btn btn-outline-primary rounded-5 px-4 py-2">
                        #@name
                    </a>
                @end
            </div>
        </div>
    </section>
</main>