@layout(default)

<article class="container mt-3 mb-0">
    <div class="bg-light rounded-5 shadow-sm row p-3">
        <header class="p-3 p-md-5">
            <h1 class="display-4"><a href="@metadata.url@og_url">@title</a></h1>
            <h2 class="lead">@description</h2>
            <div class="row">
                <p class="col-6">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-calendar4" viewBox="0 0 16 16">
  <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5M2 2a1 1 0 0 0-1 1v1h14V3a1 1 0 0 0-1-1zm13 3H1v9a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1z"/>
</svg> Publish : <time datetime="@date">@date</time>
                </p>
                @if post.author
                <p class="col-6 text-end">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-person" viewBox="0 0 16 16">
  <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z"/>
</svg> By @post.author</p>
                @end
            </div>
        </header>

        @if post.image
        <div class="ratio ratio-21x9 mt-1 mb-3 p-3">
        <img class="img-cover rounded-5 shadow"
        alt="@post.title"
        width="100%"
        height="100%"
        SRC="@post.image"/>
        </div>
        @end
        <div class="post-content p-3 p-md-5">
            @post.content
        </div>

         <div class="col-12 p-3 p-md-5">@if post.tags
               @for post.tags
               <a href="/tags/@item.html" class="btn btn-sm btn-primary rounded-5">#@item</a>
               @end
                @end
                </div>
    </div>

<div class="container rounded-5 bg-light shadow-sm mt-3">
<div class="row p-3 ">
        <div class="col-md-4">
            @if post.prev_post
                <a href="@post.prev_post.url" class="btn mt-1 mb-1 btn-lg col-12 btn-primary rounded-5">← @post.prev_post.title</a>
            @end
            </div>
            <div class="col-md-4">
            <a href="/blog.html" class="btn col-12 mt-1 mb-1 btn-lg btn-primary rounded-5">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-earmark-richtext" viewBox="0 0 16 16">
  <path d="M14 4.5V14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2h5.5zm-3 0A1.5 1.5 0 0 1 9.5 3V1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V4.5z"/>
  <path d="M4.5 12.5A.5.5 0 0 1 5 12h3a.5.5 0 0 1 0 1H5a.5.5 0 0 1-.5-.5m0-2A.5.5 0 0 1 5 10h6a.5.5 0 0 1 0 1H5a.5.5 0 0 1-.5-.5m1.639-3.708 1.33.886 1.854-1.855a.25.25 0 0 1 .289-.047l1.888.974V8.5a.5.5 0 0 1-.5.5H5a.5.5 0 0 1-.5-.5V8s1.54-1.274 1.639-1.208M6.25 6a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5"/>
</svg> All Posts</a>
</div>
            <div class="col-md-4">
            @if post.next_post
                <a href="@post.next_post.url" class="btn mt-1 mb-1 btn-lg col-12 btn-primary rounded-5">@post.next_post.title →</a>
            @end
            </div>
        </div>
    </div>

</article>