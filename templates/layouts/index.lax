@layout(default)

<main class="container">
    <section>
        <div class="col-md-12 p-3 mb-3 text-center mt-5">
            <h1><a href="@metadata.url" class="fw-bold">@metadata.title</a></h1>
            <h2 class="lead">@metadata.description</h2>
        </div>
        

            <img class="img-fluid shadow-lg rounded-5" 
                alt="@metadata.title" 
                width="100%" 
                height="100%"
                src="@hero.image" />
				
            
        <div class="row mt-3">
           <div class="col-lg-5 p-3">
		   <div class="card shadow-sm p-5 rounded-5">
		   <h3><a href="@metadata.url" class="fw-bold">@hero.title</a></h3>
		   <p>@hero.description</p>
		   </div>
		   </div>
		   
           <div class="col-lg-7 p-3 ">
		   <div class="card shadow-sm p-5 rounded-5">
		   <h3><a href="@metadata.url" class="fw-bold">@intro.title</a></h3>
		   <h4>@intro.description</h4>
			<p>@intro.text</p>	
		   </div>
		   </div>
            <img class="img-fluid shadow-lg rounded-5 mt-3 mb-3" 
                alt="@metadata.title" 
                width="100%" 
                height="100%"
                src="@intro.image" />
				
           <div class="col-lg-8 p-3 p-md-5">
		   @content
		   </div>
		   
           <div class="col-lg-4 p-3">
		   <div class="card shadow-sm p-5 rounded-5">
		   <img class="img-fluid shadow-lg rounded-5 mb-3" 
                alt="@metadata.title" 
                width="50%" 
                height="50%"
                src="@about.image" />
		   <h3><a href="@metadata.url" class="fw-bold">@about.title</a></h3>
		   <hr/>
		   <h4>@about.description</h4>
			<p>@about.text</p>
			<a href="@about.button.url" class="btn btn-primary">@about.button.text</a>
			</div>
		   </div>
        </div>                   
    </section>
</main>