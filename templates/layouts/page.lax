@layout(default)

<article class="container mt-3 mb-0">
    <div class="bg-light rounded-5 shadow-sm row p-3">
        <header class="p-3 p-md-5">
            <h1 class="display-4"><a href="@metadata.url@og_url">@title</a></h1>
            <h2 class="lead">@description</h2>
        </header>
        
         @if post.image
        <div class="ratio ratio-21x9 mt-1 mb-3 p-3">
        <img class="img-cover rounded-5 shadow"
        alt="@post.title"
        width="100%"
        height="100%"
        SRC="@post.image"/>
        </div>
        @end
        <div class="post-content p-3 p-md-5">
            @content
        </div>
        
    </div>
</article>